{
  "name": "raqet-self-hosted",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "db:init": "node scripts/init-db.js",
    "typecheck": "tsc --noEmit",
    "dev:clean": "npm run clean && next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "16.2.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "@opentelemetry/instrumentation": "0.214.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juansuero/raqet.git"
  },
  "bugs": {
    "url": "https://github.com/juansuero/raqet/issues"
  },
  "homepage": "https://github.com/juansuero/raqet#readme"
}
