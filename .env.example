# Optional. Defaults to data/raqet.sqlite.
RAQET_DB_PATH=

# Optional. Defaults to data/video-library.
RAQET_VIDEO_STORAGE_PATH=

# Optional. Defaults to ffmpeg/ffprobe on PATH. Required only for video export
# and duration probing; video metadata can still be saved without ffmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional external AI features. The solo app runs without these, but AI profile
# compile, coach replies, voice debriefs, and selected exported clip analysis
# need a configured provider key. Do not commit real keys.
RAQET_AI_PROVIDER=
RAQET_AI_DISABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional local display identity.
RAQET_SOLO_EMAIL=player@localhost
RAQET_SOLO_NAME=Player
