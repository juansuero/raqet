# Optional. Defaults to data/raqet.sqlite.
RAQET_DB_PATH=

# Optional. Defaults to data/video-library.
RAQET_VIDEO_STORAGE_PATH=

# Optional. Defaults to ffmpeg/ffprobe on PATH. Required only for video export
# and duration probing; video metadata can still be saved without ffmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional external AI features. The solo app runs without these. Configure any
# endpoint that supports the documented HTTP contract. Do not commit real keys.
RAQET_AI_DISABLED=false
RAQET_AI_API_KEY=
RAQET_AI_BASE_URL=
RAQET_AI_MODEL=
RAQET_AI_TRANSCRIPTION_MODEL=
RAQET_AI_VIDEO_ENDPOINT=
RAQET_AI_VIDEO_MODEL=

# Optional local display identity.
RAQET_SOLO_EMAIL=player@localhost
RAQET_SOLO_NAME=Player
